{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foodweek",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/widget",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/live",
      "/token",
      "/register",
      "/.well-known/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foodweek",
      "database_id": "a288bc1b-e64b-4f20-8aa7-73fda961c70b",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "LiveUpdates" },
      { "name": "LOGIN_LIMITER", "class_name": "LoginLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveUpdates", "LoginLimiter"] }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "8a33f47f99b04781a40ccd27f942f3ce"
    }
  ],
  "vars": {
    "PUBLIC_URL": "https://foodweek.fyrkant.workers.dev"
  }
}
